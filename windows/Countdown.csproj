<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11: one small exe, nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Countdown</AssemblyName>
    <RootNamespace>Countdown</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Countdown.ico</ApplicationIcon>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <Product>Countdown</Product>
    <AssemblyTitle>Countdown</AssemblyTitle>
    <Description>A countdown in the Windows taskbar</Description>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets any machine with the .NET SDK build for .NET Framework 4.8. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Countdown.ico" LogicalName="Countdown.ico" />
    <None Remove="ci\**;tools\**" />
  </ItemGroup>

</Project>
